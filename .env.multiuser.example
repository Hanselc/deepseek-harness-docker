# Copy to .env.multiuser and replace every deployment-specific value.
# Keep this file private; it is ignored by Git.

# Pinned image. The multiuser runtime is baked into the image.
DSH_IMAGE_REPOSITORY=docker.io/runzhliu/deepseek-harness
DSH_IMAGE_VERSION=0.2.3-alpha.2-r1

# Public identity. The same host drives the DSH public URL, the gateway Host
# check, and the Traefik router rule. Change it here when moving the deployment.
DSH_MULTIUSER_PUBLIC_SCHEME=https
DSH_MULTIUSER_PUBLIC_HOST=chat.codeorbita.com
# Optional non-default public port. Leave empty for https://host/ or http://host/.
DSH_MULTIUSER_PUBLIC_PORT=

# Traefik/Authelia integration. The secret is added by a Traefik headers
# middleware and required by the gateway; use at least 32 random characters.
DSH_MULTIUSER_PROXY_SECRET=replace-with-at-least-32-random-characters
DSH_MULTIUSER_PROXY_HEADER=X-DSH-Proxy-Secret
DSH_MULTIUSER_AUTH_HEADER=Remote-User
DSH_MULTIUSER_GROUPS_HEADER=Remote-Groups
DSH_MULTIUSER_AUTHELIA_MIDDLEWARE=authelia@docker
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Local users file and the single writable users volume. Use an absolute host
# path for a bind mount, or keep the named volume. The path must be writable
# by UID 1000 when it is a bind mount.
DSH_MULTIUSER_CONFIG_HOST=./config/multiuser.json
DSH_MULTIUSER_USERS_VOLUME=dsh-multiuser-users

# Workspace policy: restricted keeps the default editable and allows
# sub-workspaces under it and under /workspace/<user>/workspaces.
DSH_MULTIUSER_WORKSPACE_POLICY=restricted
DSH_MULTIUSER_WORKSPACE_PICKER=1
DSH_MULTIUSER_WORKSPACE_POLICY_LOCK_DEFAULT=1
DSH_MULTIUSER_WORKSPACE_POLICY_LOCK_ORDER=1

# Container resources. The container runs one DSH process per configured user.
DSH_MULTIUSER_MEMORY=2g
DSH_MULTIUSER_CPUS=2
DSH_MULTIUSER_PIDS_LIMIT=1024
DSH_MULTIUSER_LISTEN_INTERFACE=

# Optional provider preset override. The image already contains the preset
# chosen with PROVIDERS_CONFIG at build time; mount a JSON file and set this
# path to override it at runtime.
DSH_PROVIDERS_CONFIG=
# Optional env file with provider API keys for this compose project.
DSH_PROVIDERS_ENV_FILE=providers.env
