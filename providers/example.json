{
  "version": 1,
  "providers": {
    "ollama-cloud": {
      "displayName": "Ollama Cloud",
      "api": "openai-completions",
      "baseURL": "https://ollama.com/v1",
      "apiKeyEnv": "OLLAMA_API_KEY",
      "discover": true,
      "models": []
    },
    "example-openai-gateway": {
      "displayName": "Example OpenAI Gateway",
      "api": "openai-completions",
      "baseURL": "https://gateway.example/v1",
      "apiKeyEnv": "EXAMPLE_GATEWAY_API_KEY",
      "discover": false,
      "enabled": false,
      "models": [
        {
          "id": "example-model",
          "name": "Example Model",
          "contextWindow": 131072,
          "maxTokens": 32768
        }
      ]
    }
  },
  "defaultModel": {
    "provider": "ollama-cloud",
    "model": "gpt-oss:20b"
  }
}
